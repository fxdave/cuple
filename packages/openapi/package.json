{
  "name": "@cuple/openapi",
  "version": "2.3.1",
  "description": "Generate OpenAPI 3.0 specifications from Cuple route definitions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "src",
    "!src/**/test",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/.claude",
    "!src/**/*.bak"
  ],
  "dependencies": {
    "@cuple/inspect": "^2.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "author": "David Biro",
  "license": "MIT"
}
