{
  "name": "@cuple/mcp",
  "version": "2.6.0",
  "description": "Expose Cuple routes as MCP tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cuple-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/test",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/.claude",
    "!src/**/*.bak"
  ],
  "dependencies": {
    "@cuple/client": "^2.4.0",
    "@cuple/inspect": "^2.6.0",
    "@cuple/openapi": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "author": "David Biro",
  "license": "MIT"
}
