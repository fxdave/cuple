{
  "name": "@cuple/server",
  "version": "2.3.0",
  "description": "typescript-based RPC with REST compatibility",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "src",
    "!src/**/test",
