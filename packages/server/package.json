    "!src/**/.claude",
    "!src/**/*.bak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxdave/cuple.git"
  },
  "keywords": [
    "rpc",
    "type",
    "sharing",
    "rest",
    "procedure",
    "frontend",
    "api"
  ],
  "author": "David Biro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fxdave/cuple/issues"
  },
  "homepage": "https://github.com/fxdave/cuple#readme",
  "peerDependencies": {
    "express": "5.x.x",
    "zod": "4.x.x"
  },
  "devDependencies": {
    "@types/express": "5.x.x"
  }
}
