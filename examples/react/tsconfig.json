{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@cuple/client": ["../../packages/client/src/index.ts"],
      "@cuple/react": ["../../packages/react/src/index.ts"],
      "@cuple/server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src", "server", "vite.config.ts"]
}
