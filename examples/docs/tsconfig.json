{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "paths": {
      "@cuple/client": ["../../packages/client/src/index.ts"],
      "@cuple/server": ["../../packages/server/src/index.ts"],
      "@cuple/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
