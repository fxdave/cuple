{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "paths": {
      "@cuple/client": ["../../packages/client/src/index.ts"],
      "@cuple/server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src"]
}
